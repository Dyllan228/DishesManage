# ---------------------------------------------------------------------------
# 安卓 / Expo（A0 起）
#
# 注意 `app/android/` 本身是**要提交**的（见 docs/决策记录.md D-025）：
# 权限声明、exact-alarm 条目、buildArchs 都是手工调的，而 `expo prebuild --clean`
# 会静默丢掉这些。所以这里只忽略它的构建产物与本机路径，不忽略整个目录。
# ---------------------------------------------------------------------------
.expo/
expo-env.d.ts

# 本机 SDK 路径，因机器而异，绝不能提交
android/local.properties
app/android/local.properties

# Gradle / 构建产物
.gradle/
build/
app/android/build/
app/android/app/build/
app/android/.gradle/
app/android/.cxx/
app/android/capacitor-cordova-android-plugins/

# 签名文件：debug keystore 由工具链生成，个人 keystore 绝不入库
*.jks
*.keystore
!app/android/app/debug.keystore

# 原生调试产物
*.hprof
.cxx/
